x |>
select(
Gene_Symbol,
GeneID,
Gene_Biotype,
Chromosome,
Chromosome_Type,
Chromosome_Family
) |>
head(50)
x |>
group_by(Gene_Symbol) |>
summarise(
n_ids = n(),
n_chr_families = n_distinct(Chromosome_Family),
chromosomes = paste(unique(Chromosome), collapse = "; "),
biotypes = paste(unique(Gene_Biotype), collapse = "; "),
.groups = "drop"
) |>
filter(n_chr_families > 1)
View(x)
